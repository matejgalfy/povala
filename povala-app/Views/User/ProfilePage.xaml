<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:povala_app.ViewModels.User"
             x:Class="povala_app.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="">

    <ContentPage.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
            <Setter Property="Stroke" Value="{StaticResource Gray600}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Padding" Value="10,15" />
        </Style>
        <Style x:Key="StatValue" TargetType="Label">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource Primary}" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
        <Style x:Key="StatCaption" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource Gray300}" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="Start">
        <Label
            Text="User Profile"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding TotalAscents}" Style="{StaticResource StatValue}" />
                    <Label Text="Boulders climbed" Style="{StaticResource StatCaption}" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StatCard}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding ActiveProjects}" Style="{StaticResource StatValue}" />
                    <Label Text="Projects" Style="{StaticResource StatCaption}" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding HighestGrade}" Style="{StaticResource StatValue}" />
                    <Label Text="Highest grade" Style="{StaticResource StatCaption}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Button
            Text="Logout"
            Clicked="OnLogoutClicked"
            HorizontalOptions="Center"
            WidthRequest="200" />
    </VerticalStackLayout>
</ContentPage>
