<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="povala_app.Views.RegisterPage"
             Title="">
    <VerticalStackLayout Spacing="15" Padding="30" VerticalOptions="Center">

        <Label Text="Create an account" 
               FontSize="24" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" 
               Margin="0,0,0,20" />

        <Label Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               TextColor="Red"
               FontSize="14"
               HorizontalOptions="Center" />

        <Entry Placeholder="Name" 
               Text="{Binding Name}" />

        <Entry Placeholder="Password" 
               IsPassword="True" 
               Text="{Binding Password}" />

        <Entry Placeholder="Repeat password" 
               IsPassword="True" 
               Text="{Binding RepeatPassword}" />

        <Button Text="Register" 
                Command="{Binding RegisterCommand}" 
                Margin="0,20,0,0" />

        <Button Text="Already have an account? Log in" 
                Command="{Binding GoToLoginCommand}"
                BackgroundColor="Transparent"
                TextColor="{StaticResource Primary}"
                FontAttributes="Bold"
                FontSize="14"
                Margin="0,10,0,0" />

    </VerticalStackLayout>
</ContentPage>